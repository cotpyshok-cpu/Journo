# ==============================================================================
# Journo — Environment Configuration
# ==============================================================================
# Local Evaluation (zero config): leave defaults as-is. SQLite auto-creates & seeds!
# Production Deployment: switch DATABASE_URL to PostgreSQL and add OAuth/Map keys.

# Database: Local SQLite (default) OR Production PostgreSQL
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/journo?schema=public"

# Public App URL (used for OAuth callbacks and Stripe return URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 & Calendar API (calendar.readonly)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Routing & Maps Failover Chain (Google Maps -> HERE -> OSRM -> Local Astana Cache)
GOOGLE_MAPS_API_KEY=""
HERE_API_KEY=""

# Billing (Optional Stripe Test Mode; interactive sandbox checkout works without keys)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_MONTHLY_ID=""
STRIPE_PRICE_YEARLY_ID=""
