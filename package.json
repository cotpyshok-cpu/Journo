{
  "name": "journo",
  "version": "1.0.0",
  "private": true,
  "description": "Journo — Smart Daily Route & Schedule Planner (PWA)",
  "scripts": {
    "dev": "node scripts/setup-db.mjs && next dev",
    "build": "node scripts/setup-db.mjs && next build",
    "start": "node scripts/setup-db.mjs && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:setup": "node scripts/setup-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "chart.js": "^4.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.9"
  }
}
